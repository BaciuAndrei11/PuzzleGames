@using PuzzleGames.Frontend.Logic
@inject UserSession UserSession
@inject NavigationManager NavigationManager
@implements IDisposable

<nav class="navbar bg-secondary navbar-dark shadow-sm">
    <div class="container-fluid d-flex justify-content-between align-items-center px-4">
        
        <div class="d-flex align-items-center">
            <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasNavbar" aria-controls="offcanvasNavbar" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            
            <div class="offcanvas offcanvas-start bg-secondary text-white" tabindex="-1" id="offcanvasNavbar" aria-labelledby="offcanvasNavbarLabel">
                <div class="offcanvas-header">
                    <h3 class="offcanvas-title" id="offcanvasNavbarLabel">Games</h3>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                </div>
                <div class="offcanvas-body">
                    <ul class="navbar-nav justify-content-end flex-grow-1 pe-3">
                        <li class="nav-item">
                            <a class="nav-link active" aria-current="page" href="/">Takuzu</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link active" aria-current="page" href="/StarBattle">Star Battle</a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <div>
            @if (!UserSession.IsLoggedIn)
            {
                <a class="navbar-brand me-3" href="/login">Login</a>
                <a class="navbar-brand m-0" href="/register">Register</a>
            }
            else
            {
                <div class="d-flex align-items-center gap-3">
                    <span class="navbar-text text-white fw-semibold">
                        <i class="bi bi-person-fill me-1"></i>@UserSession.CurrentUser?.Username
                    </span>

                    <span class="badge bg-warning text-dark px-2 py-1.5 fw-bold shadow-sm">
                        LVL @UserSession.CurrentUser?.CurrentLevel
                    </span>

                    <button type="button" class="btn btn-link text-white-50 text-decoration-none p-0 ms-2 fw-medium btn-logout" @onclick="HandleLogoutAsync">
                        <i class="bi bi-box-arrow-right me-1"></i>Logout
                    </button>
                </div>
            }
        </div>

    </div>
</nav>


@code
{
    protected override void OnInitialized()
    {
        UserSession.OnChange += OnSessionChanged;
    }

    private void OnSessionChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task HandleLogoutAsync()
    {
        await UserSession.LogOutAsync();
        NavigationManager.NavigateTo("/");
    }

    public void Dispose()
    {
        UserSession.OnChange -= OnSessionChanged;
    }
}