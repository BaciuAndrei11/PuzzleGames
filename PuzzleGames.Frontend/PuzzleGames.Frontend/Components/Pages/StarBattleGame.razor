@page "/StarBattle"
@using PuzzleGames.Frontend.Logic
@using PuzzleGames.Frontend.Models

<NavBar> </NavBar>
<h1 class="text-center mt-4 text-secondary">Star Battle Puzzle</h1>
<div class="text-center text-secondary mt-2">
    <span class=" p-2 fs-5 ">
        @StarBattleGameLogic.GetFormattedTime()
    </span>
</div>
<table class="table-bordered w-auto mx-auto mt-4 shadow rounded position-relative" 
       style="border-collapse: collapse; border: 3px solid #6c757d;">
    @for (int rowIndex = 0; rowIndex < StarBattleGameLogic.StarBattleBoard.Count; rowIndex++)
    {
        int row = rowIndex;
        <tr>
            @for (int colIndex = 0; colIndex < StarBattleGameLogic.StarBattleBoard[rowIndex].Count; colIndex++)
            {
                int col = colIndex;
                
                <td class="text-center align-middle position-relative shadow-sm"
                    style="width: 80px; height: 80px; cursor: pointer; user-select: none;
                        background: @(!StarBattleGameLogic.StarBattleBoard[row][col].IsValid
                                    ? $"repeating-linear-gradient(45deg, rgba(220, 53, 69, 0.25), rgba(220, 53, 69, 0.25) 10px, transparent 10px, transparent 20px), {StarBattleGameLogic.StarBattleBoard[row][col].ConvertColor()}"
                                    : StarBattleGameLogic.StarBattleBoard[row][col].ConvertColor());
                        border: 1px solid #dee2e6;
                        border-top: @(row == 0 ? "3px solid #343a40" : "");
                        border-left: @(col == 0 ? "3px solid #343a40" : "");
                        border-bottom: @(row == StarBattleGameLogic.StarBattleBoard.Count - 1 || StarBattleGameLogic.StarBattleBoard[row][col].Color != StarBattleGameLogic.StarBattleBoard[row + 1][col].Color ? "3px solid #343a40" : "1px solid #dee2e6");
                        border-right: @(col == StarBattleGameLogic.StarBattleBoard[row].Count - 1 || StarBattleGameLogic.StarBattleBoard[row][col].Color != StarBattleGameLogic.StarBattleBoard[row][col + 1].Color ? "3px solid #343a40" : "1px solid #dee2e6");"
                    role="button"
                    @onclick="() => HandleClick(row, col)">

                    @if (StarBattleGameLogic.StarBattleBoard[row][col].Cell == StarBattleCellEnum.Star)
                    {
                        <i class="bi bi-star-fill" style="font-size: 3rem;" ></i>
                    }
                    else if (StarBattleGameLogic.StarBattleBoard[row][col].Cell == StarBattleCellEnum.MarkedX)
                    {
                        <i class="bi bi-x-lg" style="font-size: 3rem;"></i>
                    }
                </td>
            }
        </tr>
    }
</table>

@if (StarBattleGameLogic.IsGameOver)
{
    <FinishGame GameLogic="StarBattleGameLogic" OnNewGameGenerated="StateHasChanged" />
}

@code
{
    private int Size = 6;
    private StarBattleGameLogic StarBattleGameLogic;
    
    protected override void OnInitialized()
    {
        StarBattleGameLogic = new StarBattleGameLogic();
        StarBattleGameLogic.GenerateNewGame(Size);
    }
    
    private void HandleTimerTick()
    {
        
        _ = InvokeAsync(() =>
        {
            StateHasChanged();
        });
    }
    
    private async Task HandleClick(int row, int col)
    {
        await StarBattleGameLogic.ChangeCellValueAsync(row, col);
        StateHasChanged();
    }
}
